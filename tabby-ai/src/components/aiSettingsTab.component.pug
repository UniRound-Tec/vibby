h3.mb-3(translate) AI CLI

.form-line
    .header
        .title(translate) Detected CLIs
    button.btn.btn-secondary((click)='rescan()', [disabled]='scanner.scanning$ | async')
        span(*ngIf='!(scanner.scanning$ | async)', translate) Rescan
        span(*ngIf='scanner.scanning$ | async', translate) Scanning…

.form-line(*ngFor='let entry of registry')
    .header
        .title {{entry.name}}
        .description(*ngIf='isDetected(entry)') {{environmentsFor(entry)}}
        .description(*ngIf='!isDetected(entry)', translate) Not found
    toggle(
        [ngModel]='isEnabled(entry)',
        (ngModelChange)='setEnabled(entry, $event)',
    )

.form-line
    .header
        .title(translate) Additional search paths
        .description(translate) One directory per line, scanned besides PATH
    textarea.form-control(
        rows='3',
        [(ngModel)]='extraPathsText',
        (blur)='saveExtraPaths()',
    )

h3.mt-4.mb-3(*ngIf='isWindows', translate) WSL environments

.form-line(*ngFor='let target of scanner.runtimeTargets')
    ng-container(*ngIf='isWindows && target.type === "wsl"')
        .header
            .title {{target.label}}
            .description
                span WSL {{target.wslVersion || "?"}}
                span  ·
                span(*ngIf='target.isDefault', translate) Default
                span(*ngIf='!target.isDefault') {{target.state}}
        toggle(
            [ngModel]='isWslDistroEnabled(target.distro)',
            (ngModelChange)='setWslDistroEnabled(target.distro, $event)',
        )

h3.mt-4.mb-3(translate) Floating window

.form-line
    .header
        .title(translate) AI Session floating window
        .description(translate) Show recent AI sessions and click to return to their terminal
    toggle(
        [(ngModel)]='config.store.aiCli.floatingWindow.enabled',
        (ngModelChange)='config.save()',
    )

h3.mt-4.mb-3(translate) Notifications

.form-line
    .header
        .title(translate) Attention notifications
        .description(translate) Desktop notification when a session needs you or fails
    toggle(
        [(ngModel)]='config.store.aiCli.events.notifications',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Also notify when a turn completes
        .description(translate) Quiet notification on every finished turn
    toggle(
        [(ngModel)]='config.store.aiCli.events.notifyOnIdle',
        (ngModelChange)='config.save()',
    )
