.ai-dashboard
    .board-head
        .eyebrow(translate) Sessions
        .counters(*ngIf='rows.length')
            ng-container(*ngFor='let c of counters; let last = last')
                .counter([ngClass]='c.state')
                    .n {{c.count}}
                    .l {{stateLabel(c.state)}}
                .sep(*ngIf='!last') /

    .board(*ngIf='rows.length')
        .srow(
            *ngFor='let row of rows',
            [ngClass]='row.state',
            (click)='focusRow(row)',
            tabindex='0',
            (keyup.enter)='focusRow(row)',
        )
            .stword {{stateLabel(row.state)}}
            .who
                .cli-tag
                    .cli-icon(*ngIf='iconForKind(row.kind)', [innerHTML]='iconForKind(row.kind)')
                    span {{row.kind}}
                .name {{row.pane.title}}
            .caption {{captionFor(row)}}
            .dur {{durationFor(row)}}
            .feed(*ngIf='feedFor(row).length')
                .feed-line(*ngFor='let event of feedFor(row)')
                    span.t {{feedTime(event)}}
                    span {{event.summary}}

    .empty-board(*ngIf='!rows.length')
        span(translate) No running AI sessions — pick a CLI below to start one.

    .strip-head
        span.label(translate) Available CLIs
        span.count {{clis.length}}
        button.rescan((click)='rescan()', [disabled]='scanning')
            span(*ngIf='!scanning', translate) Rescan
            span(*ngIf='scanning', translate) Scanning…

    .strip(*ngIf='clis.length')
        .chip(
            *ngFor='let cli of clis',
            (click)='launch(cli)',
            tabindex='0',
            (keyup.enter)='launch(cli)',
        )
            .glyph([innerHTML]='iconForKind(cli.entry.id)')
            .nm {{cli.entry.name}}
            .ver(*ngIf='cli.version') {{cli.version}}
            .tier([class.full]='cli.entry.tier === "full"')

    .strip-empty(*ngIf='!clis.length && !scanning')
        span(translate) No AI CLIs found on this machine.
