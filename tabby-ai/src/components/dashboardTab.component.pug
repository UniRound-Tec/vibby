.dashboard-viewport
    .ai-dashboard
        .dashboard-shell
            header.dashboard-header
                img.dashboard-brand([src]='wordmark', alt='Vibby')
                .prompt-line
                    span.prompt-glyph(aria-hidden='true') ❯
                    h1(translate) Home
                    span.prompt-cursor(aria-hidden='true')

                button.scan-action(type='button', (click)='rescan()', [disabled]='scanning')
                    span.scan-icon ↻
                    span(*ngIf='!scanning', translate) Rescan
                    span(*ngIf='scanning', translate) Scanning…

            section.zone.launch-zone
                .zone-head
                    h2.zone-title(translate) Launch
                    .zone-rule
                    .pagination([class.pagination-hidden]='launchPageCount <= 1')
                        button.page-button(
                            type='button',
                            [disabled]='launchPage === 0',
                            (click)='changeLaunchPage(-1)',
                            [attr.aria-label]='"Previous page" | translate',
                            [title]='"Previous page" | translate',
                        ) ‹
                        span.page-status {{launchPage + 1}} / {{launchPageCount}}
                        button.page-button(
                            type='button',
                            [disabled]='launchPage + 1 >= launchPageCount',
                            (click)='changeLaunchPage(1)',
                            [attr.aria-label]='"Next page" | translate',
                            [title]='"Next page" | translate',
                        ) ›

                .strip(#launchStrip)
                    button.chip.terminal-chip(
                        *ngIf='launchPage === 0',
                        type='button',
                        (click)='launchTerminal()',
                    )
                        .glyph([innerHTML]='terminalIcon')
                        .chip-text
                            .nm(translate) Terminal
                            .sub
                                span(translate) Profiles & connections
                        span.chip-arrow ›

                    button.chip.cli-chip(
                        *ngFor='let card of pagedCliCards; trackBy: trackCard',
                        type='button',
                        [class.installable]='!card.detected',
                        (click)='launchCard(card)',
                    )
                        .glyph([innerHTML]='card.icon')
                        .chip-text
                            .nm {{card.entry.name}}
                            .sub
                                span.ver(*ngIf='card.runtimeSummary') {{card.runtimeSummary}}
                                span.listening(
                                    *ngIf='card.detected?.monitoring === "full"',
                                    [title]='"Listening" | translate',
                                )
                                    span.listening-dot(aria-hidden='true')
                                    span(translate) Listening
                                span.not-detected(*ngIf='!card.detected', translate) Install
                        span.chip-arrow(*ngIf='card.detected') ›
                        span.chip-arrow.install-arrow(*ngIf='!card.detected') ↓

            .dashboard-grid
                section.zone.sessions-zone
                    .zone-head
                        h2.zone-title(translate) Sessions
                        .zone-rule
                        .pagination([class.pagination-hidden]='sessionPageCount <= 1')
                            button.page-button(
                                type='button',
                                [disabled]='sessionPage === 0',
                                (click)='changeSessionPage(-1)',
                                [attr.aria-label]='"Previous page" | translate',
                                [title]='"Previous page" | translate',
                            ) ‹
                            span.page-status {{sessionPage + 1}} / {{sessionPageCount}}
                            button.page-button(
                                type='button',
                                [disabled]='sessionPage + 1 >= sessionPageCount',
                                (click)='changeSessionPage(1)',
                                [attr.aria-label]='"Next page" | translate',
                                [title]='"Next page" | translate',
                            ) ›

                    .proc-list(*ngIf='rows.length')
                        .prow(
                            *ngFor='let row of pagedRows; trackBy: trackRow',
                            [ngClass]='row.state',
                            (click)='focusRow(row)',
                            tabindex='0',
                            (keyup.enter)='focusRow(row)',
                        )
                            .session-icon(*ngIf='row.icon', [innerHTML]='row.icon', [title]='row.kind')
                            .stword
                                span.state-dot
                                span {{row.stateLabel}}
                            .prow-main
                                .prow-name
                                    .name {{row.name}}
                                    button.rename(
                                        (click)='rename(row, $event)',
                                        [attr.aria-label]='"Rename" | translate',
                                        [title]='"Rename" | translate',
                                    ) ✎
                                .prow-caption
                                    .act {{row.caption}}
                                    .live(*ngIf='row.live') {{row.live}}
                            .dur {{row.duration}}

                    .empty.session-empty(*ngIf='!rows.length')
                        span(translate) No running AI sessions — pick a CLI above to start one.

                section.zone.activity-zone
                    .zone-head
                        h2.zone-title(translate) Recent activity
                        .zone-rule
                        .pagination([class.pagination-hidden]='activityPageCount <= 1')
                            button.page-button(
                                type='button',
                                [disabled]='activityPage === 0',
                                (click)='changeActivityPage(-1)',
                                [attr.aria-label]='"Previous page" | translate',
                                [title]='"Previous page" | translate',
                            ) ‹
                            span.page-status {{activityPage + 1}} / {{activityPageCount}}
                            button.page-button(
                                type='button',
                                [disabled]='activityPage + 1 >= activityPageCount',
                                (click)='changeActivityPage(1)',
                                [attr.aria-label]='"Next page" | translate',
                                [title]='"Next page" | translate',
                            ) ›

                    .logbox(*ngIf='recent.length')
                        .tl-row(*ngFor='let row of pagedRecent; trackBy: trackEventRow')
                            span.t {{row.time}}
                            span.dot([ngClass]='row.dot')
                            .tl-content
                                .tl-meta
                                    span.who {{row.who}}
                                    span.kind {{row.kindLabel}}
                                .sum {{row.summary}}

                    .empty.activity-empty(*ngIf='!recent.length')
                        span(translate) Nothing has happened yet.

footer.statusline
    .status-left
        span.seg.brand vibby
        span.seg
            strong {{detectedCliCount}}/{{cliCards.length}}
            span(translate) Detected
        span.seg
            strong {{rows.length}}
            span(translate) Sessions
        span.seg.state([ngClass]='c.state', *ngFor='let c of counters; trackBy: trackCounter')
            span.dot(aria-hidden='true')
            span {{c.count}} {{c.label}}
    .status-right
        button.floating-window-switch(
            type='button',
            [class.active]='floatingWindowEnabled',
            [attr.aria-pressed]='floatingWindowEnabled',
            [attr.aria-label]='"Floating window" | translate',
            [title]='"Floating window" | translate',
            (click)='toggleFloatingWindow()',
        )
            span.status-label(translate) Floating window
            span.switch-track(aria-hidden='true')
                span.switch-thumb
        span.status-label(translate) Tabs location
        .mini-segmented
            button(
                type='button',
                *ngFor='let option of tabsLocations',
                [class.active]='tabsLocation === option.value',
                (click)='setTabsLocation(option.value)',
                [title]='option.label | translate',
                [attr.aria-label]='option.label | translate',
            )
                span.diagram([ngClass]='option.value')
