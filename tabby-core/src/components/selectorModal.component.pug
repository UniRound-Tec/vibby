.modal-body
    input.form-control.form-control-lg(
        type='text',
        [(ngModel)]='filter',
        autofocus,
        [placeholder]='name',
        (ngModelChange)='onFilterChange()'
    )

    //- dimmed while searching: results come from every page, so the bar is
    //- no longer describing what is in the list below it
    .selector-pages(*ngIf='pages.length', [class.dimmed]='searching')
        button.selector-page(
            *ngFor='let page of pages',
            type='button',
            [class.active]='!searching && page.name === activePage',
            (click)='selectPage(page.name)'
        ) {{ page.name }}

    .list-group.list-group-light(*ngIf='filteredOptions.length')
        ng-container(*ngFor='let option of filteredOptions; let i = index')
            label.group-header(
                *ngIf='hasGroups && headingFor(option) && headingFor(option) !== headingFor(filteredOptions[i - 1])'
            ) {{headingFor(option)}}
            a.list-group-item.list-group-item-action.d-flex.align-items-center(
                #item,
                (click)='selectOption(option)',
                [class.active]='selectedIndex == i'
            )
                profile-icon(
                    [icon]='option.icon',
                    [color]='option.color'
                )
                .title.me-2 {{getOptionText(option)}}
                .description.no-wrap.text-muted(
                    *ngIf='option.description !== getOptionText(option)'
                ) {{option.description}}
                .ms-auto
                .no-wrap.badge.text-bg-secondary.ms-2(*ngIf='selectedIndex == i && canEditSelected()')
                    span BACKSPACE
                    i.fas.fa-pencil.ms-1
                .no-wrap.badge.text-bg-secondary.ms-2(*ngIf='selectedIndex == i')
                    span ENTER
                    i.fas.fa-arrow-right.ms-1
