.colorbar([style.background-color]='tab.color', *ngIf='tab.color != null')
.progressbar([style.width]='progress + "%"', *ngIf='progress != null')
.activity-indicator(*ngIf='tab.activity$|async')
.current-tab-indicator

.index(*ngIf='!config.store.terminal.hideTabIndex && hostApp.platform === Platform.macOS', cdkDragHandle) {{displayIndex}}
.index(*ngIf='!config.store.terminal.hideTabIndex && hostApp.platform !== Platform.macOS') {{displayIndex}}

profile-icon(
    *ngIf='config.store.terminal.showTabProfileIcon && tab.icon',
    [icon]='tab.icon',
    [color]='tab.color ?? undefined'
)

.pin-indicator(*ngIf='tab.pinned')
    i.fas.fa-thumbtack

.name(
    [class.no-hover]='config.store.terminal.hideCloseButton && config.store.terminal.hideTabOptionsButton'
    cdkDrag,
    cdkDragRootElement='tab-header',
    [cdkDragData]='tab',
    (cdkDragStarted)='onTabDragStart(tab)',
    (cdkDragEnded)='onTabDragEnd()',
)
    | {{tab.customTitle || tab.title}}
    span.ai-pane-count(*ngIf='tab["aiPaneCount"]') ×{{tab["aiPaneCount"]}}

//- vibby: AI session badges, written by tabby-ai's AiTabStateService
.ai-icon(*ngIf='tab["aiIcon"]', [fastHtmlBind]='tab["aiIcon"]', [title]='tab["aiKind"]')
.ai-state(*ngIf='tab["aiStateLabel"]', [ngClass]='tab["aiState"]') {{tab["aiStateLabel"]}}
.ai-summary(*ngIf='tab["aiSummary"]') {{tab["aiSummary"]}}
.ai-pane-list(*ngIf='tab["aiPanes"]?.length > 1')
    .ai-pane(
        *ngFor='let pane of tab["aiPanes"]; trackBy: aiPaneTrackBy',
        role='button',
        tabindex='0',
        [class.active]='isAiPaneFocused(pane.pane)',
        (click)='focusAiPane(pane.pane, $event)',
        (keydown.enter)='focusAiPane(pane.pane, $event)',
        (contextmenu)='onAiPaneContextMenu(pane.pane, $event)',
        [title]='pane.name',
    )
        span.ai-pane-index {{pane.index}}
        span.ai-pane-icon(*ngIf='pane.icon', [fastHtmlBind]='pane.icon', [title]='pane.kind')
        span.ai-pane-name {{pane.name}}
        span.ai-pane-state([ngClass]='pane.state') {{pane.stateLabel}}
        span.ai-pane-summary(*ngIf='pane.summary') {{pane.summary}}
        button.ai-pane-close(
            *ngIf='!pane.pane.effectivelyPinned',
            type='button',
            title='Close',
            aria-label='Close',
            (click)='closeAiPane(pane.pane, $event)',
        ) &times;

.buttons
    button(*ngIf='!config.store.terminal.hideTabOptionsButton',(click)='onContextMenu($event)') !{require('../icons/tab-options.svg')}

    button(*ngIf='!config.store.terminal.hideCloseButton && !tab.effectivelyPinned',(click)='app.closeTab(tab, true)') &times;

ng-content
