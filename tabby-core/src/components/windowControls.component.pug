//- 手调四枚（无第三方版权）：同一光学盒（24 栅格内 ~13×13，描边 2 圆角），
//- 保证最小化/最大化/还原/关闭视觉等大。候选对比见 docs/mockups/caption-icons.html
button.minimize((click)='hostWindow.minimize()')
    svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
        path(d='M5.5 12h13')

button.maximize((click)='hostWindow.toggleMaximize()', *ngIf='!hostWindow.isMaximized()')
    svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
        rect(x='5.5', y='5.5', width='13', height='13', rx='2')

button.restore((click)='hostWindow.toggleMaximize()', *ngIf='hostWindow.isMaximized()')
    svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
        rect(x='4.5', y='9', width='10.5', height='10.5', rx='2')
        path(d='M8.5 8.5V6.5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-2')

button.close((click)='closeWindow()')
    svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
        path(d='M6.5 6.5l11 11')
        path(d='M17.5 6.5l-11 11')
